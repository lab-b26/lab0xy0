# ---------------------------------------------------------------------------
# lab0xy0 — ignored paths
#
# This repository holds the REPRODUCIBLE MACHINERY and metadata for the
# portable fuzzing lab. It does NOT hold the large generated content.
#
# Everything ignored below is either (a) a large source/build tree, (b) a
# build output, or (c) a produced artifact. All of it is recreated on the
# build host from vendor/ + patches/ + kernel/scripts/.
#
# Cloning this repo must give a small, clean tree.
# ---------------------------------------------------------------------------

# Kernel source trees (large; recreated by kernel/scripts/fetch-kernel.sh)
/kernel/sources/linux/

# Downloaded kernel tarballs (~140 MB for linux-X.Y.Z.tar.xz). These MUST stay
# untracked or a careless `git add -A` on the build host will commit them.
/kernel/sources/cache/

# Kbase working trees (pristine + patched; recreated by
# kernel/scripts/apply-patches.sh). The pristine extract is never patched
# in place — the patched copy is a separate tree.
/work/

# Per-profile build output: build/baseline, build/kcov, build/kasan, build/debug
# (generated by kernel/scripts/build.sh with make O=...)
/build/

# Produced portable artifacts (large binaries). artifacts/README.md is tracked;
# the per-profile bundles are not.
/artifacts/*
!/artifacts/README.md

# KVM / QEMU runtime images and disk files
*.qcow2
*.raw
*.img
*.iso

# Generic build outputs (belt-and-braces; O= dirs are covered above)
out/
O=*/
*.o
*.ko
*.a
*.cmd
*.dtb
*.dtbo
*.cpio
*.initramfs
bzImage
vmlinux
System.map
modules.order
Module.symvers
.*.cmd
.tmp_*
.config.old
.dep.config

# Extracted vendor comparison trees (superseded provenance; not build targets).
# r54p0 is primary and preserved as an archive under vendor/arm/.
/AX504X08X-SW-99002-r56p0-18eac0/
/VX504X08X-SW-99002-r56p0-19eac0/

# Statically linked host binaries built from qemu/target/*.c. The SOURCE is
# tracked; the compiled probe is a build output (rebuilt by
# qemu/rootfs/build-rootfs.sh), so it must never be committed.
/qemu/target/*.stable

# Local editor / scratch
__pycache__/
*.pyc
*.swp
*~
.DS_Store
*.orig
*.rej